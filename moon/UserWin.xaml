<Window x:Class="moon.UserWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:moon"
        mc:Ignorable="d"
        Title="UserWin" Height="450" Width="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Список пользователей" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Обновить" HorizontalAlignment="Right" Padding="12,4" Click="btnRefresh_Click"/>
        </DockPanel>

        <DataGrid x:Name="dgUsers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding КодПользователя}" Width="50"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding Фамилия}" Width="100"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Имя}" Width="100"/>
                <DataGridTextColumn Header="E-mail" Binding="{Binding ЭлектроннаяПочта}" Width="150"/>
                <DataGridTextColumn Header="Кодовое слово" Binding="{Binding КодовоеСлово}" Width="110"/>
                <DataGridTextColumn Header="Ответ" Binding="{Binding ОтветНаСекретныйВопрос}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Закрыть" Width="90" Height="26" HorizontalAlignment="Right" Margin="0,10,0,0" Click="btnClose_Click"/>
    </Grid>
</Window>
