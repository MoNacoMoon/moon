<Window x:Class="moon.DebugDemoWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:moon"
        mc:Ignorable="d"
        Title="Отладка программы" Height="550" Width="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Количество итераций N:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="tbIterations" Width="50" Height="26" VerticalContentAlignment="Center" Text="10" Margin="0,0,10,0"/>
            <Button Content="Выполнить цикл (F9)" Padding="10,4" Margin="3" Click="btnRunLoop_Click"/>
            <Button Content="Тест исключения" Padding="10,4" Margin="3" Click="btnThrowCustom_Click"/>
            <Button Content="Деление на 0" Padding="10,4" Margin="3" Click="btnThrowDivZero_Click"/>
            <Button Content="Отладочные классы (Debug/Trace)" Padding="10,4" Margin="3" Click="btnDebugClasses_Click"/>
            <Button Content="Очистить" Padding="10,4" Margin="3" Click="btnClearLog_Click"/>
        </WrapPanel>

        <TextBox x:Name="tbLog" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="11" Background="#F8F8F8"
                 VerticalScrollBarVisibility="Auto" Padding="8"/>

        <Button Grid.Row="2" Content="Закрыть" Width="90" Height="26" HorizontalAlignment="Right" Margin="0,10,0,0" Click="btnClose_Click"/>
    </Grid>
</Window>
